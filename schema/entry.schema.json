{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/kellyelton/transom-drivers/schema/entry.schema.json",
  "title": "Transom driver catalog entry",
  "description": "One driver package version. schema_version 1.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "name", "version", "date", "origin", "verification", "tested", "open_source", "license", "use", "redistribution", "hardware", "sources", "files", "stats"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$", "description": "Package id; the file is drivers/<id>.json" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1, "description": "The INF's DriverVer version" },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "description": "The INF's DriverVer date, ISO 8601" },
    "origin": { "enum": ["vendor", "official", "community"] },
    "verification": { "enum": ["team", "community", "field", "untested"] },
    "tested": {
      "type": "array",
      "description": "Where the team verified it; empty when untested",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["machine", "transom", "capabilities"],
        "properties": {
          "machine": { "type": "string", "minLength": 1 },
          "transom": { "type": "string", "minLength": 1, "description": "Transom version it was verified on" },
          "capabilities": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "note": { "type": "string" }
        }
      }
    },
    "open_source": { "type": "boolean" },
    "repo": { "type": "string", "format": "uri", "description": "Source repository; required when open_source is true" },
    "license": { "type": "string", "minLength": 1, "description": "SPDX id or the license's name" },
    "license_url": { "type": "string", "format": "uri" },
    "license_sha256": { "$ref": "#/definitions/sha256", "description": "Hash of the license text in the package" },
    "use": { "enum": ["permitted", "prohibited", "unresolved"] },
    "redistribution": { "enum": ["permitted", "conditional", "prohibited", "unresolved"] },
    "hardware": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "inf", "section"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "inf": { "type": "string", "minLength": 1 },
          "section": { "type": "string", "minLength": 1 }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "description": "Download URLs for the same bytes",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url"],
        "properties": {
          "url": { "type": "string", "format": "uri" },
          "sha256": { "$ref": "#/definitions/sha256" },
          "size": { "type": "integer", "minimum": 0 },
          "unverified": { "type": "boolean", "description": "true when nobody downloaded it to check the url, hash and size" }
        }
      }
    },
    "extract": {
      "type": "object",
      "description": "Declarative only: how to get the files out of the download. No scripts.",
      "additionalProperties": false,
      "required": ["type", "kept"],
      "properties": {
        "type": { "enum": ["zip", "cab", "msi", "7z", "exe-7z"] },
        "subfolder": { "type": "string", "description": "Folder inside the archive that is the package root" },
        "kept": {
          "type": "array",
          "description": "The files kept, with their hashes",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": { "path": { "type": "string", "minLength": 1 }, "sha256": { "$ref": "#/definitions/sha256" } }
          }
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "description": "The installed package, layout as in the original package",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "$ref": "#/definitions/sha256" },
          "size": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "stats": {
      "type": "object",
      "description": "Filled by the hosted service later; empty now",
      "additionalProperties": false,
      "properties": {
        "downloads": { "type": "integer", "minimum": 0 },
        "active": { "type": "integer", "minimum": 0 },
        "reverted": { "type": "integer", "minimum": 0 }
      }
    },
    "notes": { "type": "string", "description": "Honest caveats for people reading the entry" }
  },
  "if": { "properties": { "open_source": { "const": true } }, "required": ["open_source"] },
  "then": { "required": ["repo"] },
  "definitions": { "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
}
